-// add overlays to the focused view, making a hints snapshot if there isn't one
+// make a hints snapshot for the view if it does not have one yet, so plugin
+// decorations have somewhere anchored to live
+fn ensure_styled_hints_snapshot(view: &helix_view::View, doc: &mut helix_view::document::Document) {
+    if doc.inlay_hints(view.id).is_some() {
+        return;
+    }
+    let doc_text = doc.text();
+    let len_lines = doc_text.len_lines();
+    let view_height = view.inner_height();
+    let first_visible_line =
+        doc_text.char_to_line(doc.view_offset(view.id).anchor.min(doc_text.len_chars()));
+    let first_line = first_visible_line.saturating_sub(view_height);
+    let last_line = first_visible_line
+        .saturating_add(view_height.saturating_mul(2))
+        .min(len_lines);
+    doc.set_inlay_hints(
+        view.id,
+        DocumentInlayHints::empty_with_id(DocumentInlayHintsId {
+            first_line,
+            last_line,
+        }),
+    );
+}
