+    /// Add overlays that carry their own highlight, without adding a layer per
+    /// overlay. Entries are kept sorted by `char_idx`, so they can be added
+    /// unsorted. Earlier `add_overlay` layers win at the same `char_idx`.
+    pub fn add_styled_overlays(
+        &mut self,
+        overlays: impl IntoIterator<Item = &'a (Overlay, Option<Highlight>)>,
+    ) -> &mut Self {
+        self.styled_overlays.extend(overlays);
+        // stable, so overlays at the same char_idx keep their insertion order
+        self.styled_overlays
+            .sort_by(|a, b| a.0.char_idx.cmp(&b.0.char_idx));
+        self
+    }
