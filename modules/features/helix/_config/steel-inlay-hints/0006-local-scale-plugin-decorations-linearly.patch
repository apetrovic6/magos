         let mut overlay = None;
+        let mut next_styled_overlay = self.next_styled_overlay.get();
+        while let Some(&entry) = self.styled_overlays.get(next_styled_overlay) {
+            debug_assert!(entry.0.char_idx >= char_idx);
+            if entry.0.char_idx != char_idx {
+                break;
+            }
+            overlay = Some((&entry.0, entry.1));
+            next_styled_overlay += 1;
+        }
